   "url": "https://jobicy.com/jobs/155601-staff-software-engineer-sre-2",
   "jobSlug": "155601-staff-software-engineer-sre-2",
   "jobTitle": "Staff Software Engineer (SRE)",
   "companyName": "Phantom",
   "companyLogo": "https://jobicy.com/data/server-nyc0409/galaxy/mercury/2025/08/3d0a3a49-221.png",
   "jobIndustry": [
    "DevOps & Infrastructure"
