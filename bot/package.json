{
  "name": "jobhunt-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "types": "wrangler types",
    "pretypecheck": "wrangler types",
    "prelint": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  },
  "dependencies": {
    "grammy": "1.46.0",
    "zod": "4.6.5"
  }
}
