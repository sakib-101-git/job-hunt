# Copy to .env for local development. .env is git-ignored; never commit real values.
# In production these live in GitHub Actions secrets and Cloudflare Worker secrets.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs allowed to use admin commands.
ADMIN_TELEGRAM_IDS=

# Cloudflare (token scoped to D1 edit + Workers deploy on one account)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

# Fine-grained GitHub PAT, this repo only, Contents: read and write (what
# repository_dispatch needs). A Worker secret; the Worker uses it to trigger
# pipeline runs. In GitHub Actions it is the secret GH_DISPATCH_TOKEN (names
# starting with GITHUB_ are reserved there).
GITHUB_DISPATCH_TOKEN=

# LLM providers (free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: free Himalayas API key (its own 60 requests/minute instead of the shared pool)
HIMALAYAS_API_KEY=

# Optional: LinkedIn alert emails over IMAP (use an app password)
IMAP_HOST=
IMAP_EMAIL=
IMAP_APP_PASSWORD=

# Optional: independent auditor model (defaults to the strongest free model in the chain)
AUDITOR_PROVIDER=
AUDITOR_MODEL=
AUDITOR_API_KEY=

# Local development: a SQLite file used instead of D1 when the Cloudflare values
# are empty. Use an absolute path; `make run-local` sets its own.
JOBHUNT_SQLITE_PATH=

LOG_LEVEL=INFO
