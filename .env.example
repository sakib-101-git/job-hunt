# LLM — Groq (free at console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIjKlMnOpQrStUvWxYz
# TELEGRAM_CHAT_ID is your personal fallback chat ID (used only until someone
# sends /start to the bot). Friends auto-subscribe by messaging /start.
# Find your ID: message @userinfobot on Telegram.
TELEGRAM_CHAT_ID=your_chat_id_here

# LinkedIn email parsing (optional)
IMAP_HOST=imap.gmail.com
IMAP_EMAIL=your.email@gmail.com
IMAP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Logging
LOG_LEVEL=INFO
